+func pendingSessionBoolValue(values map[string]any, key string) bool {
+	if len(values) == 0 {
+		return false
+	}
+	raw, ok := values[key]
+	if !ok {
+		return false
+	}
+	switch value := raw.(type) {
+	case bool:
+		return value
+	case string:
+		return strings.EqualFold(strings.TrimSpace(value), "true")
+	default:
+		return false
+	}
+}
